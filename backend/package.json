{
  "name": "uni-inside-cms-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migration-status.ts",
    "db:check": "tsx scripts/check-database.ts",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "auth:cleanup": "tsx scripts/cleanup-expired-auth.ts",
    "analytics:rollup": "tsx scripts/rollup-analytics.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^7.0.9",
    "pino": "^9.13.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.4",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.38.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
