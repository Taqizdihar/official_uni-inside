NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_BASE_PATH=/api/v1
APP_NAME=Uni-Inside CMS API
PUBLIC_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000/admin
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://uni-inside.pages.dev,https://uniinside.net,https://www.uniinside.net
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uni-inside
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL_MODE=disabled
DB_SSL_CA_BASE64=
DB_SSL_REJECT_UNAUTHORIZED=true
REQUIRE_LATEST_MIGRATION=true

SESSION_COOKIE_NAME=uniinside_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=60
CSRF_COOKIE_NAME=uniinside_csrf
AUTH_TOKEN_PEPPER=replace-with-a-long-random-secret-of-at-least-32-chars
ANALYTICS_HASH_PEPPER=replace-with-a-different-long-random-secret-of-at-least-32-chars

PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=8
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300
ANALYTICS_RETENTION_DAYS=90

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Uni-Inside Studio
SMTP_FROM_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
